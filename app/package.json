{
  "name": "branch-review",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.wdio.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run src/e2e && pnpm test:desktop",
    "test:desktop": "pnpm tauri build --debug --no-bundle && node tests/desktop/prepare.mjs && wdio run wdio.conf.ts",
    "test:visual": "pnpm test:desktop",
    "inspect": "node tests/desktop/inspect.mjs",
    "check:local": "pnpm typecheck && pnpm lint && pnpm test && cargo test --manifest-path ../Cargo.toml --all-targets && cargo test --manifest-path src-tauri/Cargo.toml --all-targets",
    "check:full": "pnpm check:local && pnpm test:e2e",
    "version:set": "node scripts/set-version.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@shikijs/monaco": "^4.3.1",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-virtual": "^3.13.12",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-updater": "~2.10.1",
    "lucide-react": "^0.536.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-resizable-panels": "^3.0.4",
    "shiki": "^4.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tauri-apps/cli": "^2.8.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@wdio/cli": "^9.27.1",
    "@wdio/globals": "^9.27.1",
    "@wdio/local-runner": "^9.27.1",
    "@wdio/mocha-framework": "^9.27.1",
    "@wdio/spec-reporter": "^9.27.1",
    "@wdio/tauri-service": "^1.1.0",
    "@wdio/types": "^9.27.1",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  }
}
